{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/novosite/artigos-e-publicacoes/:path*",
      "destination": "/artigos-e-publicacoes/",
      "permanent": true
    },
    {
      "source": "/novosite/codigo-de-conduta/:path*",
      "destination": "/codigo-de-conduta/",
      "permanent": true
    },
    {
      "source": "/novosite/canal-de-denuncias/:path*",
      "destination": "/canal-de-denuncias/",
      "permanent": true
    },
    {
      "source": "/novosite/compliance/:path*",
      "destination": "/compliance/",
      "permanent": true
    },
    {
      "source": "/novosite/direito-digital-e-tecnologia/:path*",
      "destination": "/direito-digital-e-tecnologia/",
      "permanent": true
    },
    {
      "source": "/novosite/protecao-de-dados-lgpd/:path*",
      "destination": "/protecao-de-dados-lgpd/",
      "permanent": true
    },
    {
      "source": "/novosite/direito-do-trabalho/:path*",
      "destination": "/direito-do-trabalho/",
      "permanent": true
    },
    {
      "source": "/novosite/direito-previdenciario/:path*",
      "destination": "/direito-previdenciario/",
      "permanent": true
    },
    {
      "source": "/novosite/direito-civil-e-empresarial/:path*",
      "destination": "/direito-civil-e-empresarial/",
      "permanent": true
    },
    {
      "source": "/novosite/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/publicacoes",
      "destination": "/artigos-e-publicacoes/",
      "permanent": true
    },
    {
      "source": "/publicacoes/:path*",
      "destination": "/artigos-e-publicacoes/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' https: data: blob:; connect-src 'self' https://*.supabase.co https://api.supabase.com https://challenges.cloudflare.com; frame-src 'self' https://www.google.com https://*.google.com https://challenges.cloudflare.com blob: data:; object-src 'self' blob:; frame-ancestors 'self'"
        }
      ]
    }
  ]
}